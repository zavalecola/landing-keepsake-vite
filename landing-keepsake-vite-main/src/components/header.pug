include ../data/navigation

header.header
  .container.header__container
    a.logo(href='#top', aria-label='Keepsake - home')
      span.logo__mark(aria-hidden='true') K
      span.logo__text(aria-hidden='true') eepsake

    input#menu-toggle.menu-toggle(type='checkbox', aria-label='Toggle navigation menu')
    label.burger-btn(for='menu-toggle')
      +icon('burger')
      +icon('close')

    nav#main-nav.nav(aria-label='Main navigation')
      ul.nav__list
        each item in navItems
          li.nav__item
            a.nav__link(
              class={ 'nav__link--active': item.active },
              href=item.href,
              aria-current=item.active ? 'page' : false
            ) #{ item.label }

      .nav__actions
        button.nav__fav-btn(type='button', aria-label='Favourites')
          +icon('heart')
          span.nav__fav-text Favourites

      .nav__info
        p.nav__info-label Get in touch
        p.nav__info-text hello@keepsake.agency
        p.nav__info-text +44 20 7946 0920
        .socials.nav__socials
          each social in socials
            a.socials__item(class=`socials__item--${social.id}`, href=social.href, aria-label=social.label) #{ social.short }
