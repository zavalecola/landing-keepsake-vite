include ../../data/journal

section#journal.journal.section
  .container
    +section-header(
      'From the journal',
      'Notes on process, case studies and things that inspire us.',
      'journal__title-box',
    )
    .journal__grid
      each post in journalPosts
        article.journal-card
          .journal-card__thumb
            +picture(
              post.image,
              post.alt,
              150,
              150,
              '(min-width: 768px) 150px, 96px',
              'journal-card__img',
            )
          .journal-card__content
            p.journal-card__meta #{ post.date } / #{ post.category }
            h3.journal-card__title #{ post.title }
            p.journal-card__excerpt #{ post.excerpt }
            a.journal-card__link(href=post.href)
              | Read more
              +icon('arrow-up')
