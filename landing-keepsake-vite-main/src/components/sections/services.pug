include ../../data/services

section#about.services.section
  .container
    +section-header(
      'What do we do',
      'We are a small team of designers and makers who help brands look their best online and offline.',
    )
    .services__grid
      each service in services
        article.service-card
          .service-card__icon-bg
            +icon(service.icon)
          h3.service-card__title #{ service.title }
          p.service-card__text #{ service.text }
