{
  "name": "vite-pug-template",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"import('fs').then(f => f.copyFileSync('dist/index.pug.html', 'dist/index.html'))\"",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sass": "^1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "^8.3.3",
    "vituum": "^1.2.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead"
  ]
}
