include ../data/navigation
include ../data/footer

footer#contact.footer
  .container
    .footer__top
      .newsletter
        h2.footer__heading NEWSLETTER
        p.newsletter__desc Fresh case studies and design notes, once a month.
        form.newsletter__form(action='#newsletter-success', method='get')
          .newsletter__group
            input#newsletter-email.newsletter__input(
              type='email',
              name='email',
              placeholder='Your email address',
              required,
              aria-describedby='email-error'
            )
            +btn('SUBSCRIBE', null, 'primary').newsletter__btn(type='submit')
            p#email-error.newsletter__error Please enter a valid email address.
          .newsletter__consent
            input#consent-check.newsletter__checkbox(type='checkbox', name='consent', required)
            label.newsletter__consent-text(for='consent-check') I agree to the privacy policy

        #newsletter-success.newsletter__success(role='status')
          .newsletter__success-box
            +icon('check')
            span You're in! Check your inbox to confirm.
          p.newsletter__success-subtext One email a month. No spam, unsubscribe anytime.

      .footer__links
        each col in footerColumns
          .footer__col
            h2.footer__heading #{ col.heading }
            ul.footer__list
              each link in col.links
                li
                  a.footer__link(href=link.href) #{ link.label }

    .footer__divider

    .footer__bottom
      p.footer__copyright © 2026 Keepsake. All rights reserved.
      .socials
        each social in socials
          a.socials__item(class=`socials__item--${social.id}`, href=social.href, aria-label=social.label) #{ social.short }
