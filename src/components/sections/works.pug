include ../../data/works.pug

section#works.works
  .container
    .works__head
      h2.works__title Наші роботи
      p.works__subtitle Вибрані проєкти з брендингу та поліграфії
    .works-filter
      each cat, idx in worksCategories
        input.works-filter__radio(
          type='radio',
          name='works-filter',
          id=`filter-${cat.id}`,
          checked=cat.active ? true : null
        )
        label.works-filter__chip(for=`filter-${cat.id}`)= cat.label
      ul.works__grid
        each item, i in works
          li.works__item(data-category=item.category)
            +work-card(item, i)
