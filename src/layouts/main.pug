//- Підключаємо всі міксини глобально для всього проєкту
include ../mixins/btn.pug
include ../mixins/icon.pug
include ../mixins/picture.pug
include ../mixins/work-card.pug

doctype html
html(lang='uk')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')

    //- Блок для мета-тегів, який можна розширювати через append
    block meta
      title Keepsake — Лендинг
      meta(name='description', content='Професійний лендинг Keepsake')

    //- Підключення стилів
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')

  body
    //- Шапка сайту
    block header
      include ../components/header.pug

    //- Основний вміст сторінки
    main
      block content

    //- Футер сайту
    block footer
      include ../components/footer.pug

    //- Блок для скриптів
    block scripts
      script(type='module', src='/src/pages/index.js')
