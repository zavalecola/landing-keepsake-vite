mixin btn(text, href, variant = 'primary')
  - var variantClass = `btn--${variant}`;

  if href
    a.btn(class=variantClass, href=href)&attributes(attributes)
      if block
        block
      else
        | #{ text }
  else
    button.btn(class=variantClass, type='button')&attributes(attributes)
      if block
        block
      else
        | #{ text }
