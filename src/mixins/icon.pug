mixin icon(name, extraClass = '')
  - var iconClass = '';
  case name
    when 'burger'
      - iconClass = 'icon--burger';
    when 'close'
      - iconClass = 'icon--close';
    when 'heart'
      - iconClass = 'icon--heart';
    when 'plus'
      - iconClass = 'icon--plus';
    when 'mail'
      - iconClass = 'icon--mail';
    when 'web'
      - iconClass = 'icon--web';
    when 'motion'
      - iconClass = 'icon--motion';
    when 'print'
      - iconClass = 'icon--print';
    when 'illustration'
      - iconClass = 'icon--illustration';
    when 'arrow-up'
      - iconClass = 'icon--arrow-up';
    when 'check'
      - iconClass = 'newsletter__success-icon';
    default
      - iconClass = `icon--${name}`;

  svg.icon(class=[iconClass, extraClass], aria-hidden='true')&attributes(attributes)
    use(href=`#icon-${name}`)
