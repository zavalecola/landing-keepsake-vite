mixin icon(name, size = 20)
  svg.icon(width=size, height=size, viewBox='0 0 24 24', aria-hidden='true')&attributes(attributes)
    case name
      when 'arrow-right'
        path(
          d='M5 12h14m-6-6 6 6-6 6',
          fill='none',
          stroke='currentColor',
          stroke-width='2',
          stroke-linecap='round',
          stroke-linejoin='round'
        )
      when 'mail'
        path(
          d='M4 6h16v12H4z',
          fill='none',
          stroke='currentColor',
          stroke-width='2'
        )
        path(
          d='m4 7 8 6 8-6',
          fill='none',
          stroke='currentColor',
          stroke-width='2'
        )
      default
        circle(
          cx='12',
          cy='12',
          r='8',
          fill='none',
          stroke='currentColor',
          stroke-width='2'
        )
