mixin picture(name, alt, width, height, sizes, className = '', isFirst = false)
  - var loadingMode = false;
    unless isFirst
  - loadingMode = 'lazy';

  picture
    source(
      type='image/webp',
      srcset=`/landing-keepsake-vite/images/${name}-400.webp 400w, /landing-keepsake-vite/images/${name}-800.webp 800w`,
      sizes=sizes
    )
    img(
      class=className,
      src=`/landing-keepsake-vite/images/${name}-800.jpg`,
      alt=alt,
      width=width,
      height=height,
      loading=loadingMode,
      decoding='async',
      fetchpriority=isFirst ? 'high' : false
    )
