mixin work-card(work, index = 0)
  article.work-card
    +picture(
      work.image,
      work.alt,
      'work-card__img',
      work.width || 800,
      work.height || 632,
      index > 0,
    )
    .work-card__content
      h3.work-card__title= work.title
      unless !work.category
        span.work-card__category= work.category
