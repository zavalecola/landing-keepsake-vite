//- Підключаємо дані та міксини
include ../../data/works.pug
include ../../mixins/btn.pug
include ../../mixins/icon.pug
include ../../mixins/picture.pug
include ../../mixins/work-card.pug

section#works.works
  .container
    h2.section-title Вибрані роботи

    //- Фільтр портфоліо на :checked ~ (з lab-07) через each
    .works__filters
      each cat, i in worksCategories
        input.visually-hidden(
          type='radio',
          name='filter',
          id=`filter-${cat.id}`,
          checked=cat.active
        )
        label.filter-chip(for=`filter-${cat.id}`)= cat.label

    //- Сітка робіт з використанням each та індексу
    ul.works-grid
      each work, i in works
        li.works-grid__item(data-category=work.category)
          +work-card(work)

    //- Приклад використання міксину +btn з довільними атрибутами (&attributes) та block
    .works__action
      +btn('Усі проєкти', '#contact').btn--primary(
        aria-label='Переглянути всі проєкти Keepsake'
      )
        +icon('arrow')
